MYSQL_DATABASE=freshlink_db
MYSQL_USER=freshlink
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Copy the CLOUDINARY_URL secret from the Cloudinary API Keys page.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_FOLDER=freshlink/evidence
CLOUDINARY_ACCESS_SECONDS=300
DB_MAX_POOL_SIZE=3
DB_MIN_IDLE=0
# Enable only for the first startup; replace both passwords locally.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=
# Optional illustrative data; disabled by default.
DEMO_ENABLED=false
DEMO_PASSWORD=
